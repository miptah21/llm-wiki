/wiki/.search_index.db

# Python virtual environments
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Testing, Linting & QA caches
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

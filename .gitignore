# Environment variables (prevents API key leaks)
.env
.env.local
.env.*.local
*.env
.direnv/

# IDE / Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Obsidian user-session / workspace state (avoids merge conflicts on workspace files)
.obsidian/workspace.json
.obsidian/workspace
.obsidian/backups/

# Raw materials (ignore user-ingested documents, keep directory structure via .gitkeep)
raw/articles/*
!raw/articles/.gitkeep
raw/notes/*
!raw/notes/.gitkeep
raw/papers/*
!raw/papers/.gitkeep

# Fallback block for PDF files
*.pdf

# Compiled wiki directories and logs (ignores personal notes while keeping template files intact)
wiki/en/**
wiki/id/**
wiki/raw_sources/**
wiki/assets/**
wiki/log.md
